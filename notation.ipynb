   "source": [
    "import numpy as np\n",
    "\n",
    "arr = np.array([1,2,3,4,5])\n",
    "print(arr)\n",
    "arrs = arr[0:3]\n",
    "print(arrs)\n",
    "arrs[:] = 2\n",
    "print(arrs)\n",
    "print(arr)"
   ]
  }
