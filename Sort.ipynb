    "\n",
    "a = np.array([2,4,6,8,1,3,-9])\n",
    "print(f\"before sort: {a}\")\n",
    "a.sort()\n",
    "print(f\"after sort: {a}\")\n",
    "\n",
    "dt = np.dtype([('name','S10'),('age',int)])\n",
    "b = np.array([('Darshan',20),('ABC',30)('XYZ',10)], dtype = dt)\n",
    "b.sort(order = 'name')\n",
    "print(b)"
